# Local-first defaults. Cloud keys are unused leftovers — leave blank.
AEGIS_MODE=open-source-foundation
DATA_DIR=./data
MEMORY_DB_PATH=./data/aegis_memory.sqlite3

# Ollama (Apple Silicon / Linux). Optional — heuristic fallback if not running.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=8

# Optional voice (text UI is primary)
VOICE_STT_ENABLED=false
VOICE_TTS_ENABLED=false
WHISPER_MODEL=base
PIPER_MODEL_PATH=

# Local OpenTelemetry
OTEL_SERVICE_NAME=aegis
OTEL_EXPORTER=console
OTEL_ENDPOINT=

# Legacy hackathon keys (optional / unused in local-only mode)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
REDIS_URL=
SENTRY_DSN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional Fitbit OAuth (legacy fixture only — not primary sync)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://127.0.0.1:8000/api/fitbit/callback
AEGIS_TOKEN_KEY=

# Google OAuth (Calendar + Health scaffolds — required for live S5/S6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/google/calendar/callback
GOOGLE_HEALTH_REDIRECT_URI=http://127.0.0.1:8000/api/google/health/callback

# Weather: auto | offline | disabled
AEGIS_WEATHER=auto
