# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
REDIS_URL=
SENTRY_DSN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Intake extraction model (optional; must accept temperature=0 — Sonnet/Haiku tier,
# NOT opus-4-8/4.7/fable-5 which reject sampling params). Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Council config
CHAIRMAN_MODEL=claude-sonnet-4-5
COUNCIL_MODELS=gemini-2.5-flash,claude-haiku-4-5,gemini-2.5-pro
