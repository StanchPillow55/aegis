# aegis local-first open-source runtime environment

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
# Default to llama3.2 which runs fast on M2 16GB. Set to 'mock' for deterministic tests.
OLLAMA_MODEL=llama3.2 

# Local Database settings
SQLITE_DB_PATH=aegis_local.db
CHROMA_DB_PATH=chroma_data

# Tracing
# Default OTLP endpoint for Jaeger running via docker-compose
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Voice Models
# Set to true to mock speech operations if you haven't downloaded the models
USE_MOCK_SPEECH=true
FASTER_WHISPER_MODEL=tiny.en
PIPER_MODEL_PATH=en_US-lessac-medium.onnx

# Optional Cloud fallbacks (not required by default)
# GEMINI_API_KEY=
